<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="#0d1a12">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ನೇಗಿಲು"
        android:textSize="32sp"
        android:textColor="#4caf7d"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Setup Your Farm"
        android:textSize="20sp"
        android:textColor="#d4e8da"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tell us about your farm"
        android:textSize="13sp"
        android:textColor="#6a9478"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Name"
        android:textColor="#d4e8da"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/farmerNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your full name"
        android:inputType="textPersonName"
        android:textColor="#d4e8da"
        android:textColorHint="#6a9478"
        android:backgroundTint="#1e3326"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Village / Town"
        android:textColor="#d4e8da"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/villageInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your village or town name"
        android:inputType="textCapWords"
        android:textColor="#d4e8da"
        android:textColorHint="#6a9478"
        android:backgroundTint="#1e3326"
        android:padding="12dp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Survey Number (optional)"
        android:textColor="#d4e8da"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/surveyNumberInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="e.g. 123/4A"
        android:inputType="text"
        android:textColor="#d4e8da"
        android:textColorHint="#6a9478"
        android:backgroundTint="#1e3326"
        android:padding="12dp"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save and Continue"
        android:backgroundTint="#2d7a4f"
        android:textColor="#ffffff"
        android:padding="14dp"/>

</LinearLayout>