<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:gravity="center_vertical"
    android:background="#0d1a12">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ನೇಗಿಲು"
        android:textSize="48sp"
        android:textColor="#4caf7d"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome"
        android:textSize="18sp"
        android:textColor="#6a9478"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/viewMapButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Farm Map"
        android:backgroundTint="#4caf7d"
        android:textColor="#000000"
        android:padding="14dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/boundaryWalkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Walk Farm Boundary"
        android:backgroundTint="#2d7a4f"
        android:textColor="#ffffff"
        android:padding="14dp"/>

</LinearLayout>